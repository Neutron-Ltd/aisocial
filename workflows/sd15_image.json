{
  "meta": {
    "name": "Stable Diffusion 1.5 \u2014 Image",
    "engine": "SD 1.5",
    "kind": "image",
    "image_input": "none",
    "description": "Lightweight text-to-image. Runs on modest GPUs; good for testing your setup.",
    "models": {
      "checkpoints": [
        "v1-5-pruned-emaonly-fp16.safetensors"
      ]
    },
    "sizes": {
      "9:16": [
        512,
        896
      ],
      "1:1": [
        640,
        640
      ],
      "16:9": [
        896,
        512
      ]
    },
    "quality": {
      "draft": {
        "steps": 12
      },
      "standard": {
        "steps": 25
      }
    },
    "defaults": {
      "cfg": 7.0
    }
  },
  "prompt": {
    "1": {
      "class_type": "CheckpointLoaderSimple",
      "inputs": {
        "ckpt_name": "v1-5-pruned-emaonly-fp16.safetensors"
      }
    },
    "2": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "{{prompt}}",
        "clip": [
          "1",
          1
        ]
      }
    },
    "3": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "{{negative_prompt}}",
        "clip": [
          "1",
          1
        ]
      }
    },
    "4": {
      "class_type": "EmptyLatentImage",
      "inputs": {
        "width": "{{width}}",
        "height": "{{height}}",
        "batch_size": 1
      }
    },
    "5": {
      "class_type": "KSampler",
      "inputs": {
        "model": [
          "1",
          0
        ],
        "seed": "{{seed}}",
        "steps": "{{steps}}",
        "cfg": "{{cfg}}",
        "sampler_name": "euler",
        "scheduler": "normal",
        "positive": [
          "2",
          0
        ],
        "negative": [
          "3",
          0
        ],
        "latent_image": [
          "4",
          0
        ],
        "denoise": 1.0
      }
    },
    "6": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "5",
          0
        ],
        "vae": [
          "1",
          2
        ]
      }
    },
    "7": {
      "class_type": "SaveImage",
      "inputs": {
        "images": [
          "6",
          0
        ],
        "filename_prefix": "{{filename_prefix}}"
      }
    }
  }
}
