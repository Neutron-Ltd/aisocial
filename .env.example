# Copy to .env and adjust. .env is git-ignored; never commit real values.

# Base URL of your ComfyUI server (shown in the Studio and Connections pages)
COMFYUI_URL=http://localhost:8188

# Local preview server (scripts/serve.py)
WEBUI_HOST=127.0.0.1
WEBUI_PORT=8080

# Optional overrides for scripts/setup_comfyui.sh
# COMFYUI_REPO=https://github.com/comfyanonymous/ComfyUI.git
# COMFYUI_REF=529c80255f3f2370c39780c62a9454d95344014d
# COMFYUI_DIR=./ComfyUI
