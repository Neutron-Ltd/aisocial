# Copy to .env and fill in. .env is git-ignored; never commit real values.

# --- Required -----------------------------------------------------------------
# Random secret (32+ characters). Encrypts stored platform tokens and signs links.
# Generate one with:  python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
# Changing it later makes existing platform connections unreadable (reconnect them).
NEUTX_SECRET_KEY=

# --- Server -------------------------------------------------------------------
# The URL people (and OAuth redirects) use to reach NEUTX. Must be a public
# https URL for Instagram publishing and for most platforms' OAuth apps.
PUBLIC_BASE_URL=http://127.0.0.1:8080
HOST=127.0.0.1
PORT=8080
# Where the SQLite database and media files are stored.
DATA_DIR=./data
# Set to false to stop new sign-ups (e.g. after creating your own account).
ALLOW_SIGNUP=true
# Cookies are marked Secure automatically when PUBLIC_BASE_URL is https.
# COOKIE_SECURE=true
SESSION_DAYS=14
MAX_UPLOAD_MB=200

# --- ComfyUI ------------------------------------------------------------------
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_TIMEOUT=30
# Give up on a generation after this many seconds.
JOB_TIMEOUT=3600
# Folder with workflow JSON files (defaults to ./workflows).
# WORKFLOWS_DIR=./workflows

# --- Social platforms (each is enabled only when both values are set) ---------
# Redirect URI to register with each platform: {PUBLIC_BASE_URL}/api/oauth/<platform>/callback
# See docs/platform-setup.md.
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
# SELF_ONLY until TikTok has audited your app; then e.g. PUBLIC_TO_EVERYONE.
TIKTOK_PRIVACY_LEVEL=SELF_ONLY

INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# private | unlisted | public
YOUTUBE_PRIVACY_STATUS=private

X_CLIENT_ID=
X_CLIENT_SECRET=

# --- ComfyUI checkout (scripts/setup_comfyui.sh) ------------------------------
# COMFYUI_REPO=https://github.com/comfyanonymous/ComfyUI.git
# COMFYUI_REF=529c80255f3f2370c39780c62a9454d95344014d
# COMFYUI_DIR=./ComfyUI
